        },
        "baseVersion": {
          "type": "integer",
          "minimum": 1
        },
        "baseDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "requestId",
        "baseVersion",
        "baseDigest",
        "exportedAt"
      ],
      "additionalProperties": true
