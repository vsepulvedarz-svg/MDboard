{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proyecto CCM/VDF",
  "description": "Contrato de intercambio del JSON padre. model.js valida además la definición exacta de los 145 controles, referencias, evidencia obligatoria, versiones, fechas reales y cierre. Las revisiones de IA conservan el JSON completo y reviewContext.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "ccm-vdf-project"
    },
    "schemaVersion": {
      "const": 1
    },
    "templateVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,120}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "info": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string"
        },
        "buyer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "crm": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "manager": {
          "type": "string"
        },
        "driveUrl": {
          "type": "string"
        },
        "offerReason": {
          "type": "string"
        },
        "startDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "const": ""
            }
          ]
        },
        "targetDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "const": ""
            }
          ]
        },
        "technology": {
          "enum": [
            "undetermined",
            "ccm",
            "vdf",
            "ccm_vdf"
          ]
        },
        "offerStatus": {
          "enum": [
            "unreviewed",
            "firm",
            "reference",
            "blocked",
            "review"
          ]
        }
      },
      "required": [
        "client",
        "buyer",
        "name",
        "crm",
        "location",
        "manager",
        "driveUrl",
        "offerReason",
        "startDate",
        "targetDate",
        "technology",
        "offerStatus"
      ],
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "active",
            "closed"
          ]
        },
        "closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/closure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "closure"
      ],
      "additionalProperties": true
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "checklist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checklist"
      },
      "minItems": 145,
      "maxItems": 145
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "team": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "reviewContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/reviewContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "processedFiles": {
      "type": "array",
      "description": "Inventario acumulado con carpeta de Drive, rutas, metadatos y última versión procesada. Opcional solo para importar JSON anteriores.",
      "items": {
        "$ref": "#/$defs/processedFile"
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "templateVersion",
    "id",
    "version",
    "createdAt",
    "updatedAt",
    "info",
    "lifecycle",
    "calendar",
    "checklist",
    "documents",
    "revisions",
    "queries",
    "team",
    "history",
    "reviews",
    "analysis",
    "reviewContext"
  ],
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "documentId": {
          "type": "string"
        },
        "fileName": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "fileName",
        "locator",
        "quote"
      ],
      "additionalProperties": true
    },
    "calendar": {
      "type": "object",
      "properties": {
        "country": {
          "const": "CL"
        },
        "timeZone": {
          "const": "America/Santiago"
        },
        "countingRule": {
          "const": "exclude_start_include_end"
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2099
              },
              "complete": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "verifiedAt": {
                "type": "string",
                "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "year",
              "complete",
              "source",
              "verifiedAt"
            ],
            "additionalProperties": true
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,120}$"
              },
              "date": {
                "type": "string",
                "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
              },
              "name": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "national",
                  "regional",
                  "local",
                  "company"
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "date",
              "name",
              "scope",
              "source"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "country",
        "timeZone",
        "countingRule",
        "coverage",
        "holidays"
      ],
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "name": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "familyId": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "readStatus": {
          "enum": [
            "read",
            "unreadable",
            "metadata_only",
            "not_reviewed"
          ]
        },
        "manualLock": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "familyId",
        "revision",
        "url",
        "notes",
        "mimeType",
        "readStatus"
      ],
      "additionalProperties": true
    },
    "revision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "familyId": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "fromRevision": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "toRevision": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "fromDocumentId": {
          "type": "string"
        },
        "toDocumentId": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "justification": {
          "type": "string"
        },
        "justificationStatus": {
          "enum": [
            "documented",
            "inferred",
            "unknown"
          ]
        },
        "impact": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "manualLock": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "familyId",
        "fromRevision",
        "toRevision",
        "fromDocumentId",
        "toDocumentId",
        "summary",
        "justification",
        "justificationStatus",
        "impact",
        "evidence"
      ],
      "additionalProperties": true
    },
    "contact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "name": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "manualLock": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "company",
        "phone",
        "email",
        "notes"
      ],
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "body": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "at",
        "author",
        "body",
        "evidence"
      ],
      "additionalProperties": true
    },
    "query": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "title": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "question": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "assignedTo": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "resolution": {
          "type": "string"
        },
        "closedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "relatedChecklistIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,120}$"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "manualLock": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "question",
        "assignedTo",
        "status",
        "resolution",
        "closedAt",
        "createdAt",
        "createdBy",
        "relatedChecklistIds",
        "evidence",
        "messages"
      ],
      "additionalProperties": true
    },
    "checklist": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 23
        },
        "label": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "pillar": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "critical": {
          "type": "boolean"
        },
        "requirementSource": {
          "type": "object",
          "properties": {
            "file": {
              "const": "Requerimientos_minimos_CCM_VDF.pdf"
            },
            "page": {
              "type": "integer"
            },
            "section": {
              "type": "integer"
            }
          },
          "required": [
            "file",
            "page",
            "section"
          ],
          "additionalProperties": true
        },
        "state": {
          "enum": [
            "unreviewed",
            "available",
            "missing",
            "partial",
            "conflict",
            "not_applicable"
          ]
        },
        "value": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "manualLock": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "type": "string"
        },
        "source": {
          "enum": [
            "unreviewed",
            "manual",
            "ai"
          ]
        }
      },
      "required": [
        "id",
        "section",
        "page",
        "label",
        "criterion",
        "pillar",
        "critical",
        "requirementSource",
        "state",
        "value",
        "notes",
        "evidence",
        "manualLock",
        "updatedAt",
        "updatedBy",
        "source"
      ],
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "const": ""
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "folderUrl": {
              "type": "string"
            },
            "recursive": {
              "type": "boolean"
            },
            "discovered": {
              "type": "integer",
              "minimum": 0
            },
            "read": {
              "type": "integer",
              "minimum": 0
            },
            "unreadable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            },
            "reused": {
              "type": "integer",
              "minimum": 0,
              "description": "Archivos omitidos tras confirmar metadatos sin cambios en esta revisión."
            }
          },
          "required": [
            "folderUrl",
            "recursive",
            "discovered",
            "read",
            "unreadable",
            "notes"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "provider",
        "model",
        "reviewedAt",
        "summary",
        "coverage"
      ],
      "additionalProperties": true
    },
    "history": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,120}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
