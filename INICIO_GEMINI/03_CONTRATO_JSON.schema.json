        }
      },
      "required": [
        "days",
        "calendarDays",
        "weekendDays",
        "holidayDays",
        "excludedHolidays",
        "missingYears",
        "complete",
        "rule"
      ],
      "additionalProperties": true
    },
    "closure": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "startDate": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "sent",
            "won",
            "lost",
            "cancelled",
            "completed"
          ]
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        },
        "calendarSnapshot": {
          "$ref": "#/$defs/calendar"
        },
        "openQueries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "date",
        "startDate",
        "at",
        "actor",
        "reason",
        "outcome",
        "calculation",
        "calendarSnapshot",
        "openQueries"
      ],
