              "path": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "before": {},
              "after": {}
            },
            "required": [
              "path",
              "before",
              "after"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "at",
        "actor",
        "origin",
