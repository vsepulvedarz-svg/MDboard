        "reason",
        "changes"
      ],
      "additionalProperties": true
    },
    "calculation": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 0
        },
        "calendarDays": {
          "type": "integer",
          "minimum": 0
        },
        "weekendDays": {
          "type": "integer",
          "minimum": 0
        },
        "holidayDays": {
          "type": "integer",
          "minimum": 0
        },
        "excludedHolidays": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "missingYears": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "rule": {
